# Supabase (Project Settings → API). Só a chave publishable vai no app; NUNCA a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Mapbox (mapbox.com → Account → Access tokens). Opcional: sem ele, o endereço continua salvável, só
# sem o mapa real (fica no placeholder).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxx

# Resend (SMTP do Supabase Auth, domínio app.firestok.com.br). NÃO usar prefixo EXPO_PUBLIC_: o app não lê
# estas variáveis e a chave nunca pode ir para o bundle.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@app.firestok.com.br
RESEND_FROM_NAME=FireStock

# Pix (QR Code "copia e cola" do pagamento). Sem EXPO_PUBLIC_PIX_KEY o app usa uma chave de teste que não pertence a
# ninguém (o QR é lido pelo banco, mas nenhum dinheiro vai para lugar nenhum). Com uma chave real, quem pagar o QR
# transfere dinheiro de verdade para ela. Chave: CPF/CNPJ (só números), e-mail, telefone (+5545999999999) ou chave aleatória.
EXPO_PUBLIC_PIX_KEY=
EXPO_PUBLIC_PIX_NAME=FireStock
EXPO_PUBLIC_PIX_CITY=Cascavel
